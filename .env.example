DISCORD_TOKEN=
CLIENT_ID=
# Optional: register slash commands to one guild (instant) instead of globally
GUILD_ID=

# ── LLM provider(s) ────────────────────────────────────────────────────────
# Simple setup: fill API_KEY below (acts as the first provider).
# Multi-provider setup: fill PROVIDER1_API_KEY / PROVIDER1_BASE_URL / PROVIDER1_MODELS,
# up to PROVIDER8_. Both styles can be mixed; API_KEY (if set) is tried first.
# Providers are tried in order, and within each provider its models are tried in
# order; the first model that answers wins.
API_KEY=
API_BASE_URL=https://api.xkiro.com/v1
# One or more model ids, comma separated; the next one is tried when a model fails
MODEL=openai/gpt-4o

# Example second provider (Groq)
PROVIDER1_API_KEY=
PROVIDER1_BASE_URL=https://api.groq.com/openai/v1
# Comma separated model ids for this provider
PROVIDER1_MODELS=llama-3.3-70b-versatile

# Example third provider (OpenRouter) — copy the same three lines up to PROVIDER8_
PROVIDER2_API_KEY=
PROVIDER2_BASE_URL=https://openrouter.ai/api/v1
PROVIDER2_MODELS=google/gemini-3.1-pro,openai/gpt-4o-mini

# Optional tuning (0-1 chances)
IGNORE_CHANCE=0.15
TYPO_CHANCE=0.12
PAUSE_CHANCE=0.2
ACTIVE_WINDOW_SECONDS=180

# Optional images sent to the model per reply (0 = off)
MAX_IMAGES=3

# Automatic memory (default on): a background pass after quiet periods keeps a
# rolling summary of older chat and extracts durable facts about people.
AUTO_MEMORY=on
# Cap for the per-channel diary text, and the minimum new messages before the
# fact-extraction pass runs (fewer = more frequent, costlier).
SUMMARY_MAX_CHARS=900
MEMORY_MIN_MESSAGES=5

# Reactivity
# Chance (0-1) that a message the bot chose to ignore still gets a subtle 👀 reaction
READ_CHANCE=0.3

# Proactive follow-ups: the memory pass may flag an open topic ("exam on monday")
# and the bot circles back later. Basic limits per channel:
PROACTIVE_PER_DAY=2      # max follow-up messages per rolling 24h
PROACTIVE_MIN_HOURS=4    # minimum gap between two follow-ups (hours)
PROACTIVE_QUIET_START=23 # server-hour the bot "goes to sleep"...
PROACTIVE_QUIET_END=9    # ...and wakes up; follow-ups inside the window are postponed

# Expression
# Tenor GIF search — free key via Google Cloud Console (enable "Tenor API", create API key). Empty = GIFs off.
TENOR_API_KEY=
# Tenor content filter: off | low | medium | high
TENOR_CONTENT_FILTER=medium
# Chance (0-1) that a generated "rephrase" becomes a real send-then-edit self-correction
SELF_CORRECT_CHANCE=0.5

# Server notebook: a durable per-guild profile Mika rewrites herself (max once per hours).
SERVER_NOTEBOOK_CHARS=2000
SERVER_NOTEBOOK_HOURS=4
# Announcements: native announcement channels + channels named announce*/news are always read;
# /announce-watch adds more. Chance to react 👀 to one, and to comment in her last active
# channel (comment reuses the proactive limits; 0 = off).
ANNOUNCE_REACT_CHANCE=0.3
ANNOUNCE_COMMENT_CHANCE=0

# Optional voice replies with Piper (leave both empty to disable). See docs/TTS.md
PIPER_BIN=
PIPER_VOICE=
TTS_MAX_CHARS=300
TTS_TIMEOUT_SECONDS=30
