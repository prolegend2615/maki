DISCORD_TOKEN=
CLIENT_ID=
# Optional: register slash commands to one guild (instant) instead of globally
GUILD_ID=

API_KEY=
API_BASE_URL=https://api.xkiro.com/v1
# One or more model ids, comma separated; the next one is tried when a model fails
MODEL=openai/gpt-4o

# Optional tuning (0-1 chances)
IGNORE_CHANCE=0.15
TYPO_CHANCE=0.12
PAUSE_CHANCE=0.2
ACTIVE_WINDOW_SECONDS=180

# Optional images sent to the model per reply (0 = off)
MAX_IMAGES=3

# Optional voice replies with Piper (leave both empty to disable). See docs/TTS.md
PIPER_BIN=
PIPER_VOICE=
TTS_MAX_CHARS=300
TTS_TIMEOUT_SECONDS=30
